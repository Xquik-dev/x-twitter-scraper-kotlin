#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Xquik contributors
#
# SPDX-License-Identifier: Apache-2.0

set -euo pipefail

cd -- "$(dirname -- "$0")/.."

audit_workspace="$(mktemp -d "${TMPDIR:-/tmp}/xquik-kotlin-audit.XXXXXX")"
trap 'rm -rf -- "$audit_workspace"' EXIT

echo "==> Checking dependency licenses"
./gradlew checkLicense \
    --no-parallel \
    --no-configuration-cache \
    --no-build-cache

if [[ -n "${OSV_SCANNER_BIN:-}" ]]; then
    scanner="$OSV_SCANNER_BIN"
    if [[ ! -x "$scanner" ]]; then
        printf 'OSV_SCANNER_BIN is not executable: %s\n' "$scanner" >&2
        exit 1
    fi
else
    osv_version="2.4.0"
    platform="$(uname -s)-$(uname -m)"
    case "$platform" in
        Darwin-arm64)
            scanner_asset="osv-scanner_darwin_arm64"
            scanner_checksum="9ca3185ad63e9ab54f7cb90f46a7362be02d80e37f0123d095a54355ea202f5d"
            ;;
        Linux-x86_64)
            scanner_asset="osv-scanner_linux_amd64"
            scanner_checksum="15314940c10d26af9c6649f150b8a47c1262e8fc7e17b1d1029b0e479e8ed8a0"
            ;;
        *)
            printf 'Unsupported OSV Scanner platform: %s\n' "$platform" >&2
            exit 1
            ;;
    esac

    scanner="$audit_workspace/osv-scanner"
    scanner_url="https://github.com/google/osv-scanner/releases/download/v${osv_version}/${scanner_asset}"
    echo "==> Downloading OSV Scanner ${osv_version}"
    curl \
        --fail \
        --location \
        --proto '=https' \
        --retry 3 \
        --show-error \
        --silent \
        --tlsv1.2 \
        "$scanner_url" \
        --output "$scanner"

    if command -v sha256sum >/dev/null 2>&1; then
        actual_checksum="$(sha256sum "$scanner" | awk '{print $1}')"
    else
        actual_checksum="$(shasum -a 256 "$scanner" | awk '{print $1}')"
    fi
    if [[ "$actual_checksum" != "$scanner_checksum" ]]; then
        echo "OSV Scanner checksum verification failed." >&2
        exit 1
    fi
    chmod +x "$scanner"
fi

echo "==> Auditing locked dependencies"
scan_report="$audit_workspace/osv-scanner.json"
scan_status=0
"$scanner" scan source --recursive --format json . >"$scan_report" || scan_status=$?
if (( scan_status > 1 )); then
    printf 'OSV Scanner stopped with exit code %d.\n' "$scan_status" >&2
    exit 1
fi

# A finding blocks unless it is development-only, has no fixed version, and
# audit-exceptions.json lists it with a reason and a recheck date at most 30
# days out. Findings in the published modules' runtime classpaths always block.
if ! jq -e 'type == "array"' audit-exceptions.json >/dev/null 2>&1; then
    echo "audit-exceptions.json must hold a JSON array." >&2
    exit 1
fi
published_modules=(
    x-twitter-scraper-kotlin
    x-twitter-scraper-kotlin-client-okhttp
    x-twitter-scraper-kotlin-core
)
runtime_packages="$(
    for module in "${published_modules[@]}"; do
        awk -F '[:=]' 'NF >= 4 && $NF ~ /(^|,)runtimeClasspath(,|$)/ { print $1 ":" $2 }' \
            "$module/gradle.lockfile"
    done | sort -u | jq -R . | jq -s -c .
)"
today="$(date -u +%F)"
latest_recheck="$(date -u -v+30d +%F 2>/dev/null || date -u -d '+30 days' +%F)"

verdicts="$(
    jq -r \
        --arg root "$PWD/" \
        --arg today "$today" \
        --arg latest "$latest_recheck" \
        --argjson runtime "$runtime_packages" \
        --slurpfile exceptions audit-exceptions.json \
        '
        [
            .results[]
            | (.source.path | ltrimstr($root)) as $path
            | .packages[]
            | .package as $package
            | .vulnerabilities as $records
            | .groups[]
            | (.ids + .aliases) as $names
            | ([$records[] | select(.id | IN($names[])) | .affected[]?
                | select(.package.name == $package.name)
                | .ranges[]?.events[]? | .fixed // empty] | unique) as $fixed
            | ([$exceptions[0][]
                | select(.package == $package.name and (.id | IN($names[])))] | first) as $exception
            | {
                finding: "\(.ids[0]) \($package.name)@\($package.version)",
                path: $path,
                verdict: (
                    if ($package.name | IN($runtime[])) then
                        "blocked: shipped runtime dependency"
                    elif ($fixed | length) > 0 then
                        "blocked: fixed in \($fixed | join(", "))"
                    elif $exception == null then
                        "blocked: not listed in audit-exceptions.json"
                    elif ($exception.reason | IN("build-time only", "peer dependency provided by the host") | not) then
                        "blocked: the exception reason must be build-time only or peer dependency provided by the host"
                    elif ($exception.path | type) != "string" or $exception.path == "" then
                        "blocked: the exception needs the package path"
                    elif ($exception.recheck | type) != "string" or $exception.recheck <= $today then
                        "blocked: the exception was due for a recheck on \($exception.recheck)"
                    elif $exception.recheck > $latest then
                        "blocked: the exception recheck date is more than 30 days out"
                    else
                        "allowed until \($exception.recheck): \($exception.reason)"
                    end
                )
            }
        ]
        | group_by(.finding)[]
        | "\(.[0].verdict)\t\(.[0].finding)\t\(map(.path) | unique | join(", "))"
        ' "$scan_report"
)"

if [[ -n "$verdicts" ]]; then
    printf '%s\n' "$verdicts" | awk -F '\t' '{ printf "%s %s (in %s)\n", $2, $1, $3 }'
fi
blocked_count="$(printf '%s\n' "$verdicts" | grep -c '^blocked' || true)"
if (( blocked_count > 0 )); then
    printf '%d dependency findings block the audit.\n' "$blocked_count" >&2
    exit 1
fi

echo "Dependency licenses and vulnerabilities passed policy."
