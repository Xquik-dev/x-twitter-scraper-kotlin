#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Xquik contributors
#
# SPDX-License-Identifier: Apache-2.0

set -euo pipefail

cd -- "$(dirname -- "$0")/.."

parent_report="${1:?Pass a fresh full-source parent JaCoCo XML report.}"
shift
./gradlew coverage -PcoverageParent="$parent_report" --rerun-tasks --no-build-cache --no-configuration-cache "$@"
