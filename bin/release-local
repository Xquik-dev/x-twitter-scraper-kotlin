#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Xquik contributors
#
# SPDX-License-Identifier: Apache-2.0

set -euo pipefail
set +o xtrace

cd -- "$(dirname -- "$0")/.."

# shellcheck source=scripts/lib/temp-paths.bash
source scripts/lib/temp-paths.bash
trap remove_temp_paths EXIT
exit_on_signals

readonly repository="Xquik-dev/x-twitter-scraper-kotlin"
readonly group="com.xquik.api"
readonly module="x-twitter-scraper-kotlin"
readonly central_url="https://repo.maven.apache.org/maven2/com/xquik/api/$module"
readonly local_repository="build/local-maven-repo"
readonly signing_key_id="D2037E4157E62A59"
readonly version_pattern='^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$'

dry_run=false
for argument in "$@"; do
    case "$argument" in
        --dry-run) dry_run=true ;;
        *)
            echo "Unknown option $argument. Run bin/release-local or bin/release-local --dry-run." >&2
            exit 2
            ;;
    esac
done

step() {
    echo "==> $1"
}

refuse() {
    echo "$1" >&2
    exit 1
}

if [[ "$dry_run" == false ]]; then
    [[ -n "${MAVEN_KEYCHAIN_SERVICE:-}" ]] ||
        refuse "MAVEN_KEYCHAIN_SERVICE is unset or empty. Set it to the Keychain service that holds the Central Portal token, then run bin/release-local again."
    [[ -n "${MAVEN_SIGNING_KEYCHAIN_SERVICE:-}" ]] ||
        refuse "MAVEN_SIGNING_KEYCHAIN_SERVICE is unset or empty. Set it to the Keychain service that holds the signing key passphrase, then run bin/release-local again."
fi

workspace="$(mktemp -d "${TMPDIR:-/tmp}/xquik-kotlin-release.XXXXXX")"
temp_paths+=("$workspace")

central_has_version() {
    local status
    status="$(
        curl \
            --connect-timeout 10 \
            --location \
            --max-time 30 \
            --output /dev/null \
            --proto '=https' \
            --show-error \
            --silent \
            --tlsv1.2 \
            --write-out '%{http_code}' \
            "$central_url/$version/$module-$version.pom"
    )" || refuse "Maven Central did not answer. Check the network, then rerun."
    case "$status" in
        200) return 0 ;;
        404) return 1 ;;
        *) refuse "Maven Central answered HTTP $status. Retry later." ;;
    esac
}

upload_to_central() {
    local token_username token_password signing_passphrase signing_key
    token_username="$(
        security find-generic-password -s "$MAVEN_KEYCHAIN_SERVICE" 2>/dev/null |
            sed -n 's/^ *"acct"<blob>="\(.*\)"$/\1/p'
    )" || refuse "The Keychain did not return the item that MAVEN_KEYCHAIN_SERVICE names. Unlock the Keychain, then rerun."
    [[ -n "$token_username" ]] ||
        refuse "The item that MAVEN_KEYCHAIN_SERVICE names has no account. Store the token username as its account, then rerun."
    token_password="$(security find-generic-password -s "$MAVEN_KEYCHAIN_SERVICE" -w 2>/dev/null)" ||
        refuse "The Keychain did not return the item that MAVEN_KEYCHAIN_SERVICE names. Unlock the Keychain, then rerun."
    signing_passphrase="$(security find-generic-password -s "$MAVEN_SIGNING_KEYCHAIN_SERVICE" -w 2>/dev/null)" ||
        refuse "The Keychain did not return the item that MAVEN_SIGNING_KEYCHAIN_SERVICE names. Unlock the Keychain, then rerun."
    signing_key="$(
        printf '%s' "$signing_passphrase" |
            gpg --batch --pinentry-mode loopback --passphrase-fd 0 \
                --armor --export-secret-keys "$signing_key_id"
    )" || refuse "gpg could not export signing key $signing_key_id. Check its passphrase in the Keychain, then rerun."
    [[ -n "$signing_key" ]] ||
        refuse "gpg exported an empty signing key $signing_key_id. Import the key, then rerun."

    ORG_GRADLE_PROJECT_mavenCentralUsername="$token_username" \
        ORG_GRADLE_PROJECT_mavenCentralPassword="$token_password" \
        ORG_GRADLE_PROJECT_signingInMemoryKey="$signing_key" \
        ORG_GRADLE_PROJECT_signingInMemoryKeyPassword="$signing_passphrase" \
        ./gradlew publishAndReleaseToMavenCentral \
        -Pkotlin.compiler.execution.strategy=in-process \
        --no-build-cache \
        --no-configuration-cache \
        --no-daemon ||
        refuse "The Maven Central upload failed. Fix the errors above, then rerun."
}

step "Checking required tools"
required_tools=(curl git jq unzip xmllint)
if [[ "$dry_run" == false ]]; then
    required_tools+=(gh gpg security)
fi
for tool in "${required_tools[@]}"; do
    command -v "$tool" >/dev/null 2>&1 || refuse "$tool is not installed. Install it, then rerun."
done

step "Checking that the working tree is clean"
tree_changes="$(git status --porcelain)"
[[ -z "$tree_changes" ]] ||
    refuse "The working tree has changes. Commit or remove them, then rerun."

step "Checking that main is checked out"
[[ "$(git symbolic-ref --quiet --short HEAD || true)" == "main" ]] ||
    refuse "The current branch is not main. Switch to main, then rerun."

step "Checking that main matches origin/main"
git fetch --quiet origin main ||
    refuse "git could not fetch origin. Check the network, then rerun."
[[ "$(git rev-parse HEAD)" == "$(git rev-parse origin/main)" ]] ||
    refuse "main differs from origin/main. Pull or push main, then rerun."

step "Reading the version from build.gradle.kts"
version="$(awk -F '"' '/^ *version = "/ { print $2; exit }' build.gradle.kts)"
[[ "$version" =~ $version_pattern ]] ||
    refuse "build.gradle.kts has no valid version. Fix it, then rerun."
manifest_version="$(jq -er '."."' .release-please-manifest.json)" ||
    refuse ".release-please-manifest.json has no version. Fix it, then rerun."
[[ "$manifest_version" == "$version" ]] ||
    refuse "The manifest says $manifest_version but build.gradle.kts says $version. Align them, then rerun."
readonly version
readonly tag="v$version"

step "Checking that tag $tag does not exist yet"
remote_tag="$(git ls-remote --tags origin "refs/tags/$tag")" ||
    refuse "git could not read the tags of origin. Check the network, then rerun."
[[ -z "$remote_tag" ]] || refuse "Tag $tag already exists on origin. Bump the version, then rerun."
if git rev-parse --quiet --verify "refs/tags/$tag" >/dev/null; then
    refuse "Tag $tag exists only in this clone. Delete it with git tag -d $tag, then rerun."
fi

step "Reading the release notes for $version from CHANGELOG.md"
notes_file="$workspace/notes.md"
awk -v version="$version" '
    /^## / {
        if (found) exit
        found = ($2 == version || index($2, "[" version "]") == 1)
        next
    }
    found
' CHANGELOG.md >"$notes_file"
grep -q '[^[:space:]]' "$notes_file" ||
    refuse "CHANGELOG.md has no section for $version. Add one, then rerun."

if [[ "$dry_run" == false ]]; then
    step "Checking GitHub CLI access"
    gh auth status --hostname github.com >/dev/null 2>&1 ||
        refuse "The GitHub CLI is not signed in. Run gh auth login, then rerun."
fi

step "Checking Maven Central for $group $version"
if central_has_version; then
    already_published=true
    echo "Maven Central already has $group $version. A release skips the upload."
else
    already_published=false
    echo "Maven Central does not have $group $version yet. A release uploads it."
    if [[ "$dry_run" == false ]]; then
        step "Checking the Keychain items and the signing key"
        security find-generic-password -s "$MAVEN_KEYCHAIN_SERVICE" >/dev/null 2>&1 ||
            refuse "The Keychain has no item under the service that MAVEN_KEYCHAIN_SERVICE names. Add the Central Portal token with security add-generic-password -s \"\$MAVEN_KEYCHAIN_SERVICE\" -a <token username> -w, then rerun."
        security find-generic-password -s "$MAVEN_SIGNING_KEYCHAIN_SERVICE" >/dev/null 2>&1 ||
            refuse "The Keychain has no item under the service that MAVEN_SIGNING_KEYCHAIN_SERVICE names. Add the signing key passphrase with security add-generic-password -s \"\$MAVEN_SIGNING_KEYCHAIN_SERVICE\" -a \"\$USER\" -w, then rerun."
        gpg --batch --list-secret-keys "$signing_key_id" >/dev/null 2>&1 ||
            refuse "Signing key $signing_key_id is not in the local GPG keyring. Import it, then rerun."
    fi
fi

step "Running bin/check-local"
bin/check-local

step "Auditing dependencies for known vulnerabilities"
./scripts/audit

step "Building the Maven artifacts for $group $version"
rm -rf -- "$local_repository"
./gradlew publishAllPublicationsToLocalFileSystemRepository \
    -PpublishLocal \
    --no-build-cache \
    --no-configuration-cache \
    --no-daemon ||
    refuse "The Maven build failed. Fix the errors above, then rerun."

./scripts/maven-listing "$local_repository" "$group" "$version"

if [[ "$dry_run" == true ]]; then
    echo "Dry run finished. Nothing was published, tagged or released."
    exit 0
fi

if [[ "$already_published" == true ]]; then
    step "Skipping the upload because Maven Central already has $group $version"
else
    step "Uploading $group $version to Maven Central"
    upload_to_central
fi

step "Verifying the Maven Central signature for $tag"
bin/verify-release-signature "$tag" ||
    refuse "The published signature did not verify. Do not tag this release."

step "Creating and pushing tag $tag"
git tag --annotate "$tag" --message "$tag"
git push origin "refs/tags/$tag"

if [[ "$version" == *-* ]]; then
    release_flags=(--prerelease --latest=false)
else
    release_flags=(--latest)
fi

step "Creating GitHub release $tag"
gh release create "$tag" \
    --repo "$repository" \
    --title "$tag" \
    --notes-file "$notes_file" \
    --verify-tag \
    "${release_flags[@]}"

echo "Released $group $version to Maven Central and GitHub."
